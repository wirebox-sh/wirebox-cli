{
  "name": "@wirebox-sh/cli",
  "version": "0.4.0",
  "description": "Official CLI for Wirebox — Real-world identity and communication layer for AI agents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "wirebox": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wirebox",
    "cli",
    "agent",
    "ai",
    "email",
    "identity",
    "connect",
    "imessage"
  ],
  "homepage": "https://wirebox.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/wirebox-sh/wirebox-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wirebox-sh/wirebox-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@wirebox-sh/sdk": "^0.3.0",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
